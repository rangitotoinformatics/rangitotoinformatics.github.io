---
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'Rangitoto Informatics';

const {
  title,
  description = 'Rangitoto Informatics club website',
} = Astro.props;

const fullTitle = title ? `${title} | ${siteName}` : siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header>
      <a href="/">{siteName}</a>
      <Nav />
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>{siteName}</p>
    </footer>
  </body>
</html>