---
import 'katex/dist/katex.min.css';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
}

const siteName = 'Rangitoto Informatics';

const {
  title,
  description = 'Rangitoto Informatics club website',
} = Astro.props;

const fullTitle = title ? `${title} | ${siteName}` : siteName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />

    <title>{fullTitle}</title>

    <link rel="icon" href="/images/logos and favicons/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/images/logos and favicons/favicon.png" />

    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem('theme') ??
        (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    </script>
  </head>
  <body>
    <header>
      <a href="/">
        <img class="light-only" src="/images/logos and favicons/logo light.png" alt="" width="48" height="48" />
        <img class="dark-only" src="/images/logos and favicons/logo dark.png" alt="" width="48" height="48" />
        
        {siteName}
      </a>
      
      <div class="header-right">
        <Nav />
        <button id="theme-toggle" type="button" aria-label="Toggle dark mode">
          <span class="light-only">⏾</span>
          <span class="dark-only">☀</span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>{siteName}</p>
    </footer>
  </body>
</html>

<script>
  const button = document.querySelector('#theme-toggle')!;
  button.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
</script>

<style is:global>

  :root {
    color-scheme: light;
    --bg: #ffffff;
    --text: #1f2328;
    --muted: #59636e;
    --link: #0b5cad;
    --border: #d0d7de;
    background: var(--bg);
    --list-head: #eef3fa;
    --list-row: #ffffff;
    --list-row-alt: #f6f8fa;
  }

  :root[data-theme='dark'] {
    color-scheme: dark;
    --bg: #22262c;
    --text: #e6edf3;
    --muted: #9198a1;
    --link: #4493f8;
    --border: #3d444d;
    --list-head: #1e2a3b;
    --list-row: #161b22;
    --list-row-alt: #1c2129;
  }

  :root[data-theme='dark'] .light-only {
    display: none;
  }
  :root:not([data-theme='dark']) .dark-only {
    display: none;
  }

  body {
    max-width: 48rem;
    margin: 0 auto;
    padding: 0 1rem;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: var(--text);
  }

  main img {
    max-width: 100%;
    height: auto;
  }

  code,
  pre {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.9em;
  }

  pre {
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
  }

  a {
    color: var(--link);
  }

  header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }

  .header-right { display: flex; align-items: center; gap: 1rem; }

  .markdown-alert {
    --alert: #0969da;
    margin: 1rem 0;
    padding: 0.5rem 1rem;
    border-left: 0.25rem solid var(--alert);
  }
  .markdown-alert > :last-child { margin-bottom: 0; }
  .markdown-alert-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--alert);
  }
  .markdown-alert-title svg { fill: currentColor; }
  .markdown-alert-tip { --alert: #1a7f37; }
  .markdown-alert-important { --alert: #8250df; }
  .markdown-alert-warning { --alert: #9a6700; }
  .markdown-alert-caution { --alert: #d1242f; }
  :root[data-theme='dark'] .markdown-alert-note { --alert: #4493f8; }
  :root[data-theme='dark'] .markdown-alert-tip { --alert: #3fb950; }
  :root[data-theme='dark'] .markdown-alert-important { --alert: #ab7df8; }
  :root[data-theme='dark'] .markdown-alert-warning { --alert: #d29922; }
  :root[data-theme='dark'] .markdown-alert-caution { --alert: #f85149; }

  .problem-list {
    margin: 1rem 0;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .problem-list::before {
    content: 'Problem name';
    display: block;
    padding: 0.75rem 1.25rem;
    background: var(--list-head);
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .problem-list ul { list-style: none; margin: 0; padding: 0; }
  .problem-list li { padding: 0.75rem 1.25rem; background: var(--list-row); }
  .problem-list li:nth-child(even) { background: var(--list-row-alt); }
  .problem-list a { font-weight: 600; text-decoration: none; }
  .problem-list a:hover { text-decoration: underline; }

  #theme-toggle {
    font: inherit;
    color: inherit;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0 0.5rem;
    cursor: pointer;
  }

  header > a {
    font-weight: 600;
    color: inherit;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  footer {
    margin-top: 3rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
