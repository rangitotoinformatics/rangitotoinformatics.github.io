---
import 'katex/dist/katex.min.css';
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/lessons/', label: 'Lessons' },
  { href: '/problems/', label: 'Problems' },
  { href: '/search/', label: 'Search' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Rangitoto Informatics` : 'Rangitoto Informatics'}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="brand">Rangitoto Informatics</a>
        {nav.map((n) => <a href={n.href} class={path.startsWith(n.href) ? 'active' : ''}>{n.label}</a>)}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>
