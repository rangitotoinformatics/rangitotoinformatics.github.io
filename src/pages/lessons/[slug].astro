---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { getLessons, getProblemsForLesson } from '../../lib/content';

export async function getStaticPaths() {
  const lessons = await getLessons();
  return lessons.map((lesson, i) => ({
    params: { slug: lesson.id },
    props: { lesson, prev: lessons[i - 1], next: lessons[i + 1] },
  }));
}

const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
const practice = await getProblemsForLesson(lesson.id);
---
<Base title={lesson.data.title}>
  <article data-pagefind-body>
    <h1>{lesson.data.title}</h1>
    <div class="meta" data-pagefind-ignore>
      <Tags topics={lesson.data.topics} />
      <span data-pagefind-filter="type" hidden>Lesson</span>
      {lesson.data.topics.map((t) => <span data-pagefind-filter="topic" hidden>{t}</span>)}
    </div>
    <Content />
  </article>

  {practice.length > 0 && (
    <section>
      <h2>Practice</h2>
      <ul class="list">
        {practice.map((p) => (
          <li><a href={`/problems/${p.id}/`}>{p.data.title}</a><Tags difficulty={p.data.difficulty} /></li>
        ))}
      </ul>
    </section>
  )}

  <p class="meta">
    {prev && <a href={`/lessons/${prev.id}/`}>← {prev.data.title}</a>}
    {next && <a href={`/lessons/${next.id}/`} style="margin-left:auto">{next.data.title} →</a>}
  </p>
</Base>
