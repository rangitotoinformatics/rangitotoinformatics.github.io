---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProblems, getEditorial } from '../../lib/problems';

export async function getStaticPaths() {
  const problems = await getProblems();
  return problems.map((problem) => ({ params: { slug: problem.id }, props: { problem } }));
}

const { problem } = Astro.props;
const { Content } = await render(problem);
const editorial = await getEditorial(problem.id);
const Editorial = editorial ? (await render(editorial)).Content : null;
---

<BaseLayout title={problem.data.title}>
  <h1>{problem.data.title}</h1>
  <Content />
  {Editorial && (
    <details>
      <summary>Difficulty</summary>
      {problem.data.difficulty}
    </details>
    <details>
      <summary>Editorial</summary>
      <Editorial />
    </details>
  )}
</BaseLayout>
