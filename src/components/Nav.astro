---
const links = [
  { href: '/problems/', label: 'Problems' },
  { href: '/lessons/', label: 'Lessons' },
  { href: '/search/', label: 'Search' },
];
const path = Astro.url.pathname;
---

<nav>
  {links.map((l) => (
    <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
  ))}
</nav>